    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "compilerOptions": {
    "module": "NodeNext",
    "verbatimModuleSyntax": true
  }
